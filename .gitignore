experiments/phase1_5_encoding_validity/tool_delivery_20260911/records/
experiments/phase1_5_encoding_validity/tool_delivery_20260911/dispatches/
experiments/phase1_5_encoding_validity/tool_delivery_20260911/decisions/

# Expanded original replication: immutable raw archives remain local.
experiments/phase1_5_encoding_validity/original_expanded_20260911/records/
experiments/phase1_5_encoding_validity/original_expanded_20260911/dispatches/

# Full offline MS explanation extracts are raw-derived local artifacts.
experiments/phase1_5_encoding_validity/ms_wording_review_20260911/manifest.json
experiments/phase1_5_encoding_validity/ms_wording_review_20260911/*_EXPLANATIONS.md

# MS crossover: raw records and intents remain local.
experiments/phase1_5_encoding_validity/ms_stanza_crossover_20260912/records/
experiments/phase1_5_encoding_validity/ms_stanza_crossover_20260912/dispatches/

# Full per-record metadata/checksum index for offline repeat audit.
experiments/phase1_5_encoding_validity/repeat_stability_20260912/record_index.json

experiments/phase1_5_encoding_validity/ms_seed_replay_20260912/records/
experiments/phase1_5_encoding_validity/ms_seed_replay_20260912/dispatches/

experiments/phase1_5_encoding_validity/profile_transfer_20260912/records/
experiments/phase1_5_encoding_validity/profile_transfer_20260912/dispatches/

# Structural encoding stages: immutable raw outputs and blind material are local.
experiments/phase1_5_encoding_validity/structural_encoding_20260912/*/records/
experiments/phase1_5_encoding_validity/structural_encoding_20260912/*/dispatches/
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit/blind_pack.json
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit/private_answer_key.json
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit/manifest.json
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit/private_answer_key_rendered.json

# Schema audit replacements also contain private/raw-derived blind material.
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit_schema_*/blind_pack.json
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit_schema_*/private_answer_key*.json
experiments/phase1_5_encoding_validity/structural_encoding_20260912/audit_schema_*/manifest.json

# Immutable API artifacts for the all-ten fresh-profile follow-up.
experiments/phase1_5_encoding_validity/all_ten_followup_20260912/records/
experiments/phase1_5_encoding_validity/all_ten_followup_20260912/dispatches/
experiments/phase1_5_encoding_validity/all_ten_followup_20260912/progress.json
experiments/phase1_5_encoding_validity/all_ten_followup_20260912/progress.tmp

# Large exact request bundles stay local; their SHA256 hashes are committed.
experiments/phase1_5_encoding_validity/all_ten_followup_20260912/manifest.json
experiments/phase1_5_encoding_validity/all_ten_followup_20260912/request_preview.json

# Separate continuation: immutable raw payloads remain local.
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment2/records/
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment2/dispatches/
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment2/progress.*

# Third continuation: raw responses and runtime telemetry remain local.
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment3/records/
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment3/dispatches/
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment3/progress.*
experiments/phase1_5_encoding_validity/all_ten_followup_20260912_segment3/run_process.json

# Relocated research archives: raw payloads and runtime/private artifacts stay local.
archive/**/records/
archive/**/dispatches/
archive/**/preserved_attempts/
archive/**/private_answer_key*.json
archive/**/blind_pack.json

# Previously tracked historical records keep their tracking status when relocated.
# No newly collected raw payload should be added merely because it moved to archive/.

# Named PDF exports of the paper; the source of truth is docs/paper/ and the build.
Claude outputs/

# Scratch directory; never contains source.
tmp/
