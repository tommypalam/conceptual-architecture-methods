# =============================================================
# PARIA — .gitignore
# =============================================================

# ----- RAW DATA (never committed — too large, may be sensitive) -----
data/raw/

# New Option-C raw records remain local artefacts; manifests/reports are reviewable.
experiments/phase1_5_encoding_validity/option_c_*/records/

# ----- SIMULATION OUTPUTS (ephemeral — pipeline regenerates them) -----
# Commit output only when it represents a verified milestone result.
# Routine runs should not pollute history.
output/tables/
output/figures/
output/logs/

# ----- PROCESSED DATA (regenerable — commit the scripts, not the artifacts) -----
data/processed/

# ----- PYTHON -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.whl
.pytest_cache/
.mypy_cache/

# ----- VIRTUAL ENVIRONMENTS -----
.venv/
venv/
env/
ENV/
.conda/

# ----- JUPYTER -----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ----- IDE / EDITOR -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- PYMC / ARVIZ TRACES (large, regenerable) -----
*.nc
*.zarr/

# ----- MESA SIMULATION CHECKPOINTS -----
*.pkl
*.pickle

# ----- OS -----
desktop.ini
$RECYCLE.BIN/

# ----- CLAUDE CODE SESSION DATA -----
.claude/

# ----- SECRETS -----
.env
*.key
secrets.*
/output/

